{
  "productName": "ClipHive",
  "version": "0.4.0",
  "identifier": "com.cliphive.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipHive — Every video on any page",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mohdbushnaq/ClipHive/releases/latest/download/update-manifest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQUUwN0FCOTdCOUQ1QUMKUldTczFibVhxd2V1UUthWS9keGRaZXhNVUNzU05YTWNUcW4zOXllZlFyV3JHeUNVZmhBTmd5V3EK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/yt-dlp.exe",
      "resources/ffmpeg.exe",
      "resources/ffprobe.exe",
      "resources/aria2c.exe"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
